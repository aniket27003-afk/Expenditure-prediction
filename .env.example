# Copy this file to .env and fill in your keys. Safe to commit.
# Get a Groq key from https://console.groq.com/keys (starts with "gsk_...")
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30
LLM_FALLBACK_TO_RULES=true

DATABASE_URL=sqlite:///./expenses.db
# DATABASE_URL=postgresql+psycopg://expenses:expenses@localhost:5432/expenses

APP_NAME=Smart Expense & Spending Analyzer
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

VITE_API_URL=
